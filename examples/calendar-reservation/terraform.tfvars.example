# Copy to terraform.tfvars and edit.
project_id = "my-project"
zone       = "us-central1-c" # zone of the reservation
name       = "tpu7x-cal"
# Can match the full reservation (e.g. "4x4x4" = 64 chips / 16 hosts) or a
# smaller sub-slice within it (e.g. "2x2x2" = 8 chips / 2 hosts, "2x2x4" = 16 chips / 4 hosts, "2x4x4" = 32 chips / 8 hosts)
topology = "4x4x4"

# Auto-created reservation of your approved calendar-mode future reservation
# (defaults to the future reservation's name):
#   gcloud compute future-reservations describe FR --zone ZONE --format='value(reservationName)'
reservation_name = "my-tpu7x-calendar-res"

# Phase 1 (before start_time): false → empty MIG. Phase 2: true → full slice.
activate_slice = false

network    = "default"
subnetwork = null

# Optional: override with a custom OS image (see ../../custom_image.md)
# source_image = "projects/my-project/global/images/family/debian-12-tpu7x"

# Optional: attach non-boot read-write Hyperdisk Balanced data disks per VM
# (tpu7x-standard-4t caps total VM performance at 320,000 IOPS and 7,200 MiB/s across all disks)
# data_disk_count                  = 3
# data_disk_size_gb                = 500
# data_disk_provisioned_iops       = 105000
# data_disk_provisioned_throughput = 2400

