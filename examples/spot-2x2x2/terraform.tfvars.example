# Copy to terraform.tfvars and edit.
project_id = "my-project"
zone       = "us-central1-c"
name       = "tpu7x-spot-2x2x2"
topology   = "2x2x2"

# STOP keeps the (stopped) hosts around after preemption; DELETE lets the MIG
# recreate the whole slice when capacity returns.
instance_termination_action = "STOP"

network            = "default"
subnetwork         = null
enable_external_ip = false
wait_for_instances = true

# Optional: override with a custom OS image (see ../../custom_image.md)
# source_image = "projects/my-project/global/images/family/debian-12-tpu7x"

# Optional: attach non-boot read-write Hyperdisk Balanced data disks per VM
# (tpu7x-standard-4t caps total VM performance at 320,000 IOPS and 7,200 MiB/s across all disks)
# data_disk_count                  = 2
# data_disk_size_gb                = 500
# data_disk_provisioned_iops       = 150000
# data_disk_provisioned_throughput = 2400

